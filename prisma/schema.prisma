// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  gst         Float?
  weight      Float?
  quantity    Int?
  images      String   // JSON string of string[]
  ingredients String   // JSON string of string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  email     String
  rating    Int
  review    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  data      String   // Store the entire user object as JSON string to support dynamic fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // 'pageview' or 'event'
  data      String   // JSON content
  timestamp DateTime @default(now())
}
